# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ── Rust / Soroban ───────────────────────────────────────────────────────────
# Cargo build output
contracts/target/
contracts/mocks/target/
# Compiled WASM artifacts 
**/*.wasm
# Generated Stellar CLI TypeScript bindings
lib/contracts/generated/
# Reference copy of the contract IDs produced by `npm run deploy:testnet`
# (the deploy CLI writes them into .env.local directly)
.env.contracts
# Backup the deploy CLI takes before rewriting an existing env file
*.env.local.bak
.env.local.bak
# Per-network deployment state used by `npm run deploy:testnet -- --resume`
contracts/.deployments/


# playwright
playwright-report/
test-results/